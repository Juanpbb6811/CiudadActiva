# =======================================================================
# Variables de Entorno - Supabase & CiudadActiva Backend
# =======================================================================

# Opción 1: Conexión mediante Supabase Pooler (Recomendada para IPv4 / Windows / macOS / Linux)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.tu_id_proyecto
SPRING_DATASOURCE_PASSWORD=tu_contraseña_supabase_aqui

# Opción 2: Conexión Directa a Supabase (IPv6 / Cloud)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.tu_id_proyecto.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=tu_contraseña_supabase_aqui

# Configuración del servidor y seguridad
PORT=8080
JWT_SECRET=CiudadActivaSecretKey2026SecureKeyWithMoreThan256BitsLongForHMACSHA256Algorithm
JPA_DDL_AUTO=update
SHOW_SQL=false

# Configuración de Correo Transaccional (Resend API HTTP - Recomendado para Render)
RESEND_API_KEY=re_tu_clave_aqui
MAIL_FROM=CiudadActiva <onboarding@resend.dev>

# Google Gemini Vision (Autotriage con IA)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Firebase Cloud Messaging (Notificaciones Push a la app Android)
FCM_SERVER_KEY=tu_server_key_de_fcm_aqui
FIREBASE_PROJECT_ID=ciudadactiva-app

# Base de Datos Secundaria EXCLUSIVA de Imágenes (Opcional - Arquitectura Multi-Database)
# SPRING_IMAGE_DATASOURCE_URL=jdbc:postgresql://tu-db-secundaria.supabase.co:5432/postgres?sslmode=require
# SPRING_IMAGE_DATASOURCE_USERNAME=postgres
# SPRING_IMAGE_DATASOURCE_PASSWORD=tu_contraseña_secundaria
